---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import StatPill from "@/components/StatPill.astro";
import { company } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  headline: string;
  subheadline?: string;
  ctaLabel: string;
  ctaHref: string;
  showForm: boolean;
  formIntent: string;
  campaign?: string;
  accent: "teal" | "sky" | "violet";
  stats: { value: string; label: string }[];
}
const {
  title,
  description,
  eyebrow,
  headline,
  subheadline,
  ctaLabel,
  ctaHref,
  showForm,
  formIntent,
  campaign,
  accent,
  stats,
} = Astro.props;

const accentGlow: Record<string, string> = {
  teal: "from-accent/20",
  sky: "from-sky/20",
  violet: "from-indigo-400/20",
};
---

<!--
  Minimal, conversion-focused chrome for campaign pages: brand + back-link only,
  no full nav, so the page stays single-purpose.
-->
<BaseLayout title={title} description={description}>
  <section class="relative overflow-hidden">
    <div
      class:list={[
        "pointer-events-none absolute inset-0 bg-gradient-to-b to-transparent",
        accentGlow[accent],
      ]}
    >
    </div>

    <div class="container-x relative grid items-start gap-12 py-16 sm:py-24 lg:grid-cols-2">
      <div>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 class="display mt-5">{headline}</h1>
        {subheadline && <p class="lead mt-5 max-w-xl">{subheadline}</p>}

        {
          stats.length > 0 && (
            <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {stats.map((s) => (
                <StatPill value={s.value} label={s.label} />
              ))}
            </div>
          )
        }

        {
          !showForm && (
            <div class="mt-8">
              <a href={ctaHref} class="btn-primary">
                {ctaLabel}
              </a>
            </div>
          )
        }

        <div class="prose-landing mt-12 max-w-xl text-muted">
          <slot />
        </div>
      </div>

      {
        showForm && (
          <div class="lg:sticky lg:top-24">
            <ContactForm intent={formIntent} campaign={campaign ?? ""} heading={ctaLabel} />
            <p class="mt-3 text-center text-xs text-muted">
              No spam. We reply from a real human at {company.email}.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style is:global>
  .prose-landing h2 {
    @apply mt-8 text-xl font-semibold text-mist;
  }
  .prose-landing h3 {
    @apply mt-6 text-lg font-semibold text-mist;
  }
  .prose-landing p {
    @apply mt-3 leading-relaxed;
  }
  .prose-landing ul {
    @apply mt-3 space-y-2 pl-5;
  }
  .prose-landing li {
    @apply list-disc leading-relaxed marker:text-accent;
  }
  .prose-landing blockquote {
    @apply mt-5 border-l-2 border-accent/50 pl-4 italic text-mist/90;
  }
  .prose-landing a {
    @apply text-accent-soft underline-offset-2 hover:underline;
  }
</style>

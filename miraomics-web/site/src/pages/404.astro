---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — Miraomics" description="Page not found.">
  <section class="section">
    <div class="container-x flex min-h-[50vh] flex-col items-center justify-center text-center">
      <span class="eyebrow">404</span>
      <h1 class="display mt-5">This page wandered off</h1>
      <p class="lead mt-4 max-w-md">The page you're after doesn't exist. Let's get you back to the platform.</p>
      <div class="mt-8 flex gap-3">
        <a href="/" class="btn-primary">Home</a>
        <a href="/miratyper" class="btn-ghost">MiraTyper</a>
      </div>
    </div>
  </section>
</BaseLayout>

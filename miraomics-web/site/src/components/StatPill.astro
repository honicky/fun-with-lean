---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="card flex flex-col gap-1 px-5 py-4">
  <span class="text-2xl font-semibold tracking-tight accent-text sm:text-3xl">{value}</span>
  <span class="text-xs leading-snug text-muted">{label}</span>
</div>

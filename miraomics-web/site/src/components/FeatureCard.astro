---
interface Props {
  title: string;
  body: string;
  icon?: "spark" | "shield" | "layers" | "chart" | "dna" | "clock";
}
const { title, body, icon = "spark" } = Astro.props;

const paths: Record<string, string> = {
  spark: "M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18",
  shield: "M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z",
  layers: "M12 3l9 5-9 5-9-5 9-5zM3 12l9 5 9-5M3 16l9 5 9-5",
  chart: "M4 19V5M4 19h16M8 17v-5M12 17V8M16 17v-3M20 17v-7",
  dna: "M6 3c0 6 12 6 12 12M18 3c0 6-12 6-12 12M7 6h10M7 18h10M9 9h6M9 15h6",
  clock: "M12 7v5l3 2M12 21a9 9 0 110-18 9 9 0 010 18z",
};
---

<div class="card card-hover">
  <span class="grid h-10 w-10 place-items-center rounded-lg border border-accent/30 bg-accent/10 text-accent-soft">
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d={paths[icon]}></path>
    </svg>
  </span>
  <h3 class="mt-4 text-lg font-semibold text-mist">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{body}</p>
</div>

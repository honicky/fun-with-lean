# Public (compiled into the static build) -----------------------------------
# Canonical site URL, used for SEO + canonical tags.
PUBLIC_SITE_URL="https://www.miraomics.bio"

# Base URL of the form / tracking API (API Gateway HTTP API stage URL or
# custom domain, e.g. https://api.miraomics.bio). Provided by Terraform output
# `app_api_base_url`.
PUBLIC_API_BASE_URL="https://api.miraomics.bio"

# Cognito Hosted UI configuration for the internal dashboard login.
# All come from Terraform outputs in the `auth` module.
PUBLIC_COGNITO_DOMAIN="https://auth.miraomics.bio"
PUBLIC_COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
PUBLIC_COGNITO_REGION="us-east-1"
# Where Cognito redirects back after login (must be registered as a callback
# URL on the app client).
PUBLIC_DASHBOARD_REDIRECT_URI="https://www.miraomics.bio/dashboard/callback"
